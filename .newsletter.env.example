# Template for .newsletter.env — the real, non-committed secrets file that
# lib/env.php loads on the server. See lib/env.php and docs/newsletter.md §2.2.
#
# Copy this file to .newsletter.env on the server (NOT in git) and fill in
# real values. `chmod 600` it so only the PHP process's user can read it.

# 32+ random bytes (hex is fine), signs the double opt-in confirm link.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotating this invalidates every unconfirmed (not-yet-clicked) confirm link.
NEWSLETTER_TOKEN_SECRET=

# Resend API key, permission "Sending access" only, restricted to the
# updates.cheatsheets.davidveksler.com domain. Create at
# https://resend.com/api-keys — never use the full-access RESEND_API_KEY here.
RESEND_SENDING_KEY=

# Where "someone signed up" notifications go. Optional: leave blank to skip
# the owner-notification email entirely (the confirmation email to the
# subscriber still sends).
CHEATSHEET_NOTIFY_EMAIL=

# Resend audience (segment) ID that scripts/newsletter_sync.py syncs
# confirmed subscribers into. Not read by subscribe.php or confirm.php
# directly, but kept here so all newsletter secrets/config live in one file.
# Create at https://resend.com/audiences.
RESEND_SEGMENT_ID=

# Optional overrides; subscribe.php has sane defaults for both.
# NEWSLETTER_FROM_ADDRESS=Cheatsheets <hello@updates.cheatsheets.davidveksler.com>
# NEWSLETTER_REPLY_TO=
