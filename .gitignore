/.claude
/.playwright-mcp

# index.php per-mtime metadata cache (regenerated at runtime)
/.metadata-cache.json

# Personal Command Deck data — real numbers stay local, never committed (public repo)
command-deck-data.local.json

# Email signup store written by subscribe.php — subscriber addresses stay local (public repo)
/.subscribers.jsonl

# Confirmed-subscriber (sendable) queue written by confirm.php — same reason. See docs/newsletter.md.
/.confirmed.jsonl

# Cloudflare API token for manual popularity refreshes (refresh-popularity.py) — secret, never committed
/.cloudflare.env

# Newsletter secrets (NEWSLETTER_TOKEN_SECRET, RESEND_SENDING_KEY, etc.) loaded
# by lib/env.php on the server — secret, never committed. See lib/env.php and
# .newsletter.env.example for the template.
/.newsletter.env

# Python virtualenv for generate-image-previews.py etc.
/.venv
web.config
/__pycache__
/scripts/__pycache__

# ~/.gitignore_global has a blanket "lib/" rule (aimed at other projects' vendor/
# build lib dirs) that also matches this repo's own lib/ (newsletter.php,
# resend.php, chrome.php, env.php) — carve it back out so those files, and any
# new ones, are tracked without needing `git add -f` every time.
!lib/
!lib/**
