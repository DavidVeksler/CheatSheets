#!/usr/bin/env bash
# Tracked pre-push hook: guard pushes to the live 'production' docroot.
#
# Runs the deploy preflight + validation ("python scripts/deploy.py --check")
# whenever you push to the production remote, so even a raw `git push production`
# gets the seatbelt. Other remotes (origin) are untouched.
#
# Enable in a clone with:  git config core.hooksPath .githooks
#
# Git passes the remote name as $1 and the URL as $2.
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

is_production=0
[ "$remote_name" = "production" ] && is_production=1
case "$remote_url" in
  *cheatsheets.davidveksler.com*) is_production=1 ;;
esac
[ "$is_production" -eq 1 ] || exit 0

# deploy.py sets this when it issues its own push — don't double-validate.
[ "${CHEATSHEETS_DEPLOY:-}" = "1" ] && exit 0

# Retired: the live site is the Cloudflare Worker (since 2026-09-28); a push to
# 'production' only updates the unused droplet rollback copy. Block a raw push
# and point at the real deploy. `scripts/deploy.py --legacy` (which sets
# CHEATSHEETS_DEPLOY above) or CHEATSHEETS_LEGACY_PUSH=1 opts in.
if [ "${CHEATSHEETS_LEGACY_PUSH:-}" != "1" ]; then
  echo "pre-push: push to 'production' blocked: it targets the DO droplet, which no longer serves this site." >&2
  echo "pre-push: deploy the live site (Cloudflare Worker) with scripts/deploy-cloudflare.ps1 (or .sh)." >&2
  echo "pre-push: to update the droplet rollback copy anyway, set CHEATSHEETS_LEGACY_PUSH=1." >&2
  exit 1
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
if   command -v python  >/dev/null 2>&1; then py=python
elif command -v python3 >/dev/null 2>&1; then py=python3
else echo "pre-push: no python found; run scripts/deploy.py manually." >&2; exit 1
fi

echo "pre-push: validating before pushing to production..."
if ! "$py" "$root/scripts/deploy.py" --check; then
  echo "pre-push: push blocked — see the message above (an out-of-sync branch is auto-synced, just re-run your push; anything else needs a fix or ./deploy.sh with a --skip-* flag)." >&2
  exit 1
fi
